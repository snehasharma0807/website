{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": ".ts-out",
    "baseUrl": "."
  },
  "include": ["lib", "tests"],
  "exclude": ["node_modules"]
}
